# Automation web với Selenium
from selenium import webdriver
from selenium.webdriver.common.by import By
import time

def web_automation():
    driver = webdriver.Chrome()
    driver.get("https://example.com")
    element = driver.find_element(By.NAME, "username")
    element.send_keys("your_username")
    time.sleep(2)  # Đợi thao tác hoàn tất
    driver.quit()

# Automation file system
import os
import shutil

def organize_files():
    downloads_dir = "downloads"
    documents_dir = "documents"
    if not os.path.exists(documents_dir):
        os.makedirs(documents_dir)
    for filename in os.listdir(downloads_dir):
        if filename.endswith(".pdf"):
            shutil.move(os.path.join(downloads_dir, filename), os.path.join(documents_dir, filename))

from appium import webdriver as appium_webdriver

def open_android_app():
    desired_caps = {
        "platformName": "Android",
        "deviceName": "Android Device",  # hoặc dùng adb devices để lấy tên thiết bị
        "appPackage": "com.example.app",  # thay bằng package app của bạn
        "appActivity": "com.example.app.MainActivity",  # thay bằng activity chính của app
        "noReset": True
    }
    driver = appium_webdriver.Remote("http://localhost:4723/wd/hub", desired_caps)
    time.sleep(5)  # Đợi app mở lên
    driver.quit()

def open_ios_app():
    desired_caps = {
        "platformName": "iOS",
        "platformVersion": "16.0",  # thay bằng version iOS của thiết bị
        "deviceName": "iPhone 14",  # thay bằng tên thiết bị thật
        "udid": "your_device_udid",  # thay bằng UDID của thiết bị thật
        "bundleId": "com.example.iosapp",  # thay bằng bundleId của app
        "automationName": "XCUITest",
        "noReset": True
    }
    driver = appium_webdriver.Remote("http://localhost:4723/wd/hub", desired_caps)
    time.sleep(5)  # Đợi app mở lên
    driver.quit()

if __name__ == "__main__":
    print("Bắt đầu automation web...")
    web_automation()
    print("Đã xong automation web. Bắt đầu sắp xếp file...")
    organize_files()
    print("Hoàn thành automation!")
    # Mở app Android:
    # open_android_app()
    # Mở app iOS:
    open_ios_app()